# Default: public data only. Live trading requires BOTH switches plus UI resume.
MODE=observe
LIVE_TRADING=false
DEDICATED_ACCOUNTS_CONFIRMED=false
# Current Aster API does NOT advertise FOK. Strict FOK intentionally blocks trading.
# IOC is an explicit opt-in: partial fills are hedged, NEVER silently downgraded.
ASTER_FIRST_TIF=FOK
# IOC only: relax the trigger limit by this percent; consumes buffer, not a higher trigger threshold.
# Default disabled. Tokyo explicitly uses 0.1. FOK and emergency rollback are unaffected.
ASTER_IOC_SLIPPAGE_PCT=0
# Only set true after explicit Binance-style FOK probe has verified real behavior.
# This permits FOK despite missing timeInForce metadata; never enables IOC implicitly.
ASTER_FOK_VERIFIED=false
HOST=127.0.0.1
PORT=3321
DATA_DIR=./data
# Required outside loopback. Random >=32 chars; HTTP Basic username admin.
ADMIN_PASSWORD=
# Default: dedicated accounts. Shared mode requires explicit authorization + symbol ownership.
SHARED_ACCOUNT_MODE=false
SHARED_AUTOTRADE_ENABLED=false
SHARED_SYMBOLS=
SHARED_FOREIGN_PAIR_FILES=
SHARED_RESERVATION_FILE=
SHARED_EXCHANGES_FILE=
SHARED_NOTIFY_FILE=
# Optional executable hook to coordinate all co-hosted consumers after real 418/429.
RATE_LIMIT_STOP_HOOK=
ASTER_USER_ADDRESS=
ASTER_SIGNER_PRIVATE_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Alternative to HMAC secret: PEM Ed25519 key path.
BINANCE_ED25519_KEY_PATH=
ASTER_FEE_PCT=0.05
BINANCE_FEE_PCT=0.05
EXEC_BUFFER_PCT=0.15
MAX_FUNDING_COST_PCT=0.3
DEPTH_TRUST=0.3
BOOK_MAX_AGE_MS=600
BOOK_MAX_SKEW_MS=300
MAX_CLOCK_OFFSET_MS=3000
REQUEST_TIMEOUT_MS=3000
ORDER_RESOLVE_MS=5000
ACCOUNT_POLL_MS=15000
ACCOUNT_MAX_AGE_MS=30000
MAX_ORDER_USD=100
MAX_TOTAL_POSITION_USD=1000
MAX_DAILY_LOSS_USD=20
MIN_MARGIN_BUFFER_USD=50
MAX_MARGIN_USE_PCT=30
ROLLBACK_MAX_LOSS_USD=5
ROLLBACK_MAX_SLIPPAGE_PCT=1
COOLDOWN_MS=1500
LEVERAGE=2
TG_BOT_TOKEN=
TG_CHAT_ID=
# Trade confirmations use the normal bot in SHARED_NOTIFY_FILE (not the alert bot).
TRADE_TELEGRAM_ENABLED=false
TG_TRADE_BOT_TOKEN=
TG_TRADE_CHAT_ID=
